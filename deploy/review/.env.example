# ============================================================
# 公文审核智能体 — 环境配置模板
# 用法：cp .env.example .env 后编辑 .env 填入真实值
# 说明：API key 属 secret；URL/模型名属行为设置，均有默认值
# ============================================================

# ---- 必填 ----

# API Server 鉴权密钥（Bearer token），必须 ≥16 字符强随机值
# 生成：openssl rand -hex 24
API_SERVER_KEY=

# 火山引擎 LLM API Key（或 DeepSeek 等其他 OpenAI 兼容厂商的 key）
LLM_API_KEY=

# ---- 可选（有合理默认）----

# LLM 接口地址与模型名（默认火山引擎 ark 端点；换厂商改这两项即可）
LLM_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
LLM_MODEL=deepseek-v3-250324

# Tavily 检索 API Key（权威党建平台检索用；留空则降级为纯 LLM 审核）
TAVILY_API_KEY=

# MinIO 根账号（生产环境务必改强密码）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=hermes-files

# MinIO 对外可达地址（host:port）。
# 批注文档的下载 URL 是 MinIO 预签名 URL，网关容器内以 minio:9000 生成，
# 外部客户端无法解析该地址，需在此配置外部可达入口重写 URL。
# 例：MINIO_PUBLIC_ENDPOINT=http://192.168.1.10:9000
MINIO_PUBLIC_ENDPOINT=

# 宿主机端口（防冲突时可改）
HOST_API_PORT=8642
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 镜像引用（docker load 后即为 hermes-agent:review；离线导出含 minio/mc）
HERMES_IMAGE=hermes-agent:review
MINIO_IMAGE=minio/minio:latest
MC_IMAGE=minio/mc:latest
